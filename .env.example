# Copy to .env and fill in. .env is gitignored; never commit it.

# Battle.net developer portal client (https://develop.battle.net/access/clients)
BNET_CLIENT_ID=
BNET_CLIENT_SECRET=

# Region of your account: us | eu | kr | tw
BNET_REGION=us

# Must match a redirect URI registered on the client exactly
BNET_REDIRECT_URI=http://localhost:8000/auth/callback

# Forever looks characters up by first name and surname
CHARACTER_NAME=Brumboldt
CHARACTER_SURNAME=Doomlet

# Where to send the browser after login: the Vite dev server while developing,
# "/" when the backend serves the built frontend
POST_LOGIN_REDIRECT=http://localhost:5173/

# SQLite file for snapshots
DATABASE_URL=sqlite:///data/character-planner.db

# Copy to .env and fill in. .env is gitignored; never commit it.

# Battle.net developer portal client (https://develop.battle.net/access/clients)
BNET_CLIENT_ID=
BNET_CLIENT_SECRET=

# Region of your account: us | eu | kr | tw
BNET_REGION=us

# Only for the optional Battle.net login: syncs use the client alone (ADR 0027). Must
# match a redirect URI registered on the client exactly.
BNET_REDIRECT_URI=http://localhost:8000/auth/callback

# Forever looks characters up by first name and surname. These name the first character
# only: the first start saves it in the database and reads them no more (ADR 0036).
CHARACTER_NAME=Brumboldt
CHARACTER_SURNAME=Doomlet

# Where to send the browser after login: the Vite dev server while developing,
# "/" when the backend serves the built frontend
POST_LOGIN_REDIRECT=http://localhost:5173/

# SQLite file for snapshots (compose sets its own path on the data volume)
DATABASE_URL=sqlite:///data/character-planner.db

# Logging (ADR 0019): DEBUG | INFO | WARNING | ERROR; text | json; LOG_DIR adds rotating
# files (server.log and access.log for the API, worker.log for the worker)
# LOG_LEVEL=INFO
# LOG_FORMAT=text
# LOG_DIR=data/logs

# --- Deployment (docs/self-hosting.md) -----------------------------------------------
# Scheduled worker: hours between syncs and item pool refreshes
# SYNC_EVERY_HOURS=6
# POOL_EVERY_HOURS=24
# ENCHANTS_EVERY_HOURS=168

# compose.yaml: where the API listens on the host (127.0.0.1 = this machine only)
# PLANNER_BIND=127.0.0.1
# PLANNER_PORT=8000
# Host names the planner answers to, besides localhost (#124): the address you open it
# at, comma separated. Needed with PLANNER_BIND=0.0.0.0 or behind your own proxy; the
# Tailscale overlay adds *.ts.net itself.
# PLANNER_HOSTS=192.168.1.20,planner.example.com
# compose.yaml: run a published release instead of building (docs/self-hosting.md, #61)
# PLANNER_IMAGE=ghcr.io/thechainercygnus/character-planner:0.2

# The page footer's Source link (AGPL, #43): point it at your fork if you change the code
# SOURCE_URL=https://github.com/thechainercygnus/character-planner

# Minutes between syncs of one character by hand (#17, ADR 0039): 0 turns it off.
# SYNC_COOLDOWN_MINUTES=15

# Postgres (#44, ADR 0038): with compose.postgres.yaml, the database password.
# POSTGRES_PASSWORD=<a long random password>

# Users (#16, ADR 0037): off by default, as a single-person instance needs. On: every page
# asks for a Battle.net sign-in; the first account becomes the admin. Sign-ups after the
# first are closed unless PLANNER_SIGNUPS=on.
# PLANNER_USERS=on
# PLANNER_SIGNUPS=on

# Who runs this instance, shown on the privacy notice (#133): an email address, a web
# address or a name. See docs/privacy.md.
# OPERATOR_CONTACT=you@example.org

# compose.tailscale.yaml: machine name on the tailnet, and an auth key for the first
# start (https://login.tailscale.com/admin/settings/keys). Remove the key once joined.
# TS_HOSTNAME=character-planner
# TS_AUTHKEY=
